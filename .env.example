# Server-side only. Never expose this key through an EXPO_PUBLIC_* variable.
MUDITAM_OPENAI_API_KEY=

# Cost-sensitive multimodal default; override only after benchmark testing.
MUDITAM_OPENAI_VISION_MODEL=gpt-5.6-luna
# Cost-sensitive text model. Override locally to compare quality and latency.
MUDITAM_CHAT_MODEL=gpt-5.6-luna
# Enabled by default. Set false only as an emergency operational switch.
MUDITAM_CHAT_ENABLED=true
AI_PLATFORM_SERVICE_SECRET=

# Local defaults. Hosting providers may supply PORT; PORT takes precedence.
MUDITAM_REVIEW_HOST=127.0.0.1
MUDITAM_REVIEW_PORT=4173
