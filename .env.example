# Runtime
NODE_ENV=development
ENABLE_METABOLIC_ASSISTANT=true
METABOLIC_HOST=0.0.0.0
METABOLIC_PORT=3100
METABOLIC_API_PREFIX=/api/v1/metabolic-assistant
METABOLIC_LOG_LEVEL=info

# MongoDB (used in the next data-model/seeding phase)
METABOLIC_MONGODB_URI=

# OpenAI (used in the extraction/chat phases)
METABOLIC_OPENAI_API_KEY=
METABOLIC_EXTRACTION_MODEL=gpt-4o-mini
METABOLIC_CHAT_ENABLED=false
METABOLIC_CHAT_MODEL=gpt-4o-mini
METABOLIC_OPENAI_STORE=false
METABOLIC_OPENAI_TIMEOUT_MS=120000

# Diabetes chat policy
METABOLIC_CHAT_ALLOWED_CATEGORIES=GREETING,REPORT_VALUES,REPORT_COMPARISON,GLYCEMIC_EDUCATION,DIABETES_EDUCATION,LIFESTYLE_EDUCATION
METABOLIC_CHAT_ALLOWED_REPORT_STATUSES=NEEDS_REVIEW,READY
METABOLIC_CHAT_MAX_QUESTIONS_PER_WINDOW=20
METABOLIC_CHAT_MAX_CONVERSATIONS_PER_USER=5
METABOLIC_CHAT_MAX_REPORTS_PER_CONVERSATION=3
METABOLIC_CHAT_LIMIT_WINDOW_MINUTES=1440
METABOLIC_CHAT_MAX_QUESTION_CHARS=1000
METABOLIC_CHAT_MAX_HISTORY_MESSAGES=10
METABOLIC_CHAT_MAX_ANSWER_WORDS=180
METABOLIC_CHAT_MAX_OUTPUT_TOKENS=700
METABOLIC_CHAT_MAX_KNOWLEDGE_RESULTS=5
METABOLIC_CHAT_MIN_MARKER_CONFIDENCE=0.6
METABOLIC_CHAT_PERSONA_NAME=Muditam Diabetes Guide
METABOLIC_CHAT_TONE=calm, clear, respectful, and supportive
METABOLIC_CHAT_RESPONSE_STYLE=Use simple English, short paragraphs, and practical explanations.
METABOLIC_CHAT_REJECTION_MESSAGE=I can only help with diabetes, blood-sugar health, and blood-report questions.
METABOLIC_CHAT_MISSING_REPORT_DATA_MESSAGE=I could not find that value clearly in this report. Please check the report or ask about a value that was extracted.
METABOLIC_CHAT_SAFETY_MESSAGE=This may need urgent medical attention. Please contact a doctor or local emergency service now. Do not wait for this chat.
METABOLIC_CHAT_DISCLAIMER=This is general diabetes education. Report-based answers use automatically extracted data. It is not a diagnosis or a replacement for a doctor.

# Report upload limits
METABOLIC_MAX_FILE_BYTES=10485760
METABOLIC_MAX_PDF_PAGES=30
METABOLIC_MAX_REPORTS_PER_USER=10
METABOLIC_REQUIRE_SUBJECT_ID_FOR_UPLOAD=true

# Private report storage (local for this phase; S3 adapter comes later)
METABOLIC_STORAGE_PROVIDER=local
METABOLIC_LOCAL_STORAGE_DIR=.data/metabolic-assistant/reports
METABOLIC_STORAGE_BUCKET=
METABOLIC_STORAGE_PREFIX=metabolic-assistant/reports
METABOLIC_STORAGE_REGION=
METABOLIC_STORAGE_ENDPOINT=
METABOLIC_STORAGE_ACCESS_KEY_ID=
METABOLIC_STORAGE_SECRET_ACCESS_KEY=

# Extraction worker
METABOLIC_WORKER_ENABLED=false
METABOLIC_WORKER_CONCURRENCY=1
METABOLIC_MAX_JOB_ATTEMPTS=3
METABOLIC_WORKER_POLL_INTERVAL_MS=2000
METABOLIC_JOB_LEASE_MS=180000

# Retention and spend controls
METABOLIC_REPORT_RETENTION_DAYS=30
METABOLIC_CHAT_RETENTION_DAYS=30
METABOLIC_DAILY_SPEND_LIMIT=
