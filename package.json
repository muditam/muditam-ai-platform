{
  "name": "muditam-ai-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Document extraction and AI services for Muditam",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env dist/review-server.js",
    "build": "npm run build:server && npm run widget:build",
    "build:server": "rm -rf dist && tsc -p tsconfig.build.json",
    "extract": "npm run build --silent && node dist/cli.js",
    "structure": "npm run build --silent && node dist/structure-cli.js",
    "process": "npm run build --silent && node dist/process-cli.js",
    "verify:report": "npm run build --silent && node dist/verify-cli.js",
    "benchmark": "npm run build --silent && node dist/benchmark-cli.js",
    "eval:chat": "npm run build --silent && node --env-file-if-exists=.env dist/chat/evaluation/run-evaluation.js",
    "knowledge:ingest": "npm run build --silent && node --env-file-if-exists=.env dist/chat/ingest-products.js",
    "widget:dev": "vite --config apps/storefront-widget/vite.config.ts",
    "widget:typecheck": "tsc -p apps/storefront-widget/tsconfig.json --noEmit",
    "widget:build": "vite build --config apps/storefront-widget/vite.config.ts",
    "review": "npm run build --silent && node --env-file-if-exists=.env dist/review-server.js",
    "review:mobile": "MUDITAM_REVIEW_HOST=0.0.0.0 npm run review",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "busboy": "^1.6.0",
    "mongodb": "^7.5.0",
    "openai": "^7.1.0",
    "pdfjs-dist": "^6.2.108",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/node": "^26.1.2",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
